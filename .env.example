# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# CinetPay Configuration
# Store CINETPAY_API_KEY and CINETPAY_SITE_ID only as Supabase Edge Function secrets.

# Secret dédié à la signature HMAC des prix (prebook/checkout).
# Ne JAMAIS réutiliser SUPABASE_SERVICE_ROLE_KEY pour cet usage.
# Générer une valeur aléatoire, ex: openssl rand -base64 32
PRICE_SIGNING_SECRET="your-price-signing-secret"

# AI & Chatbot APIs
LOVABLE_API_KEY="your-lovable-api-key"

# Travel APIs
RAPIDAPI_KEY="your-rapidapi-key"
AMADEUS_API_KEY="your-amadeus-api-key"
AMADEUS_API_SECRET="your-amadeus-api-secret"
TRAVELPAYOUTS_TOKEN="your-travelpayouts-token"
AERODATABOX_API_KEY="your-aerodatabox-api-key"
AERODATABOX_HOST="aerodatabox.p.rapidapi.com"
TRAVEL_ADVISOR_API_KEY="your-travel-advisor-api-key"
TRAVEL_ADVISOR_HOST="travel-advisor.p.rapidapi.com"
FLIGHT_FARE_SEARCH_API_KEY="your-flight-fare-search-api-key"
FLIGHT_FARE_SEARCH_HOST="flight-fare-search.p.rapidapi.com"

# Email Services
RESEND_API_KEY="your-resend-api-key"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@example.com"

# Web Push (VAPID Keys)
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT sont des secrets d'Edge
# Function (supabase secrets set ...), jamais dans ce .env frontend.
# VITE_VAPID_PUBLIC_KEY doit être la même clé publique que VAPID_PUBLIC_KEY
# côté serveur — c'est la seule des trois valeurs safe à exposer au client.
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"

# Application Configuration
VITE_APP_NAME="Bossiz Conciergerie"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENVIRONMENT="production"
